/* Контекстная реклама — page-specific (rk-clean shell from home-clean.css) */
/* Later @font-face overrides home-clean swap → optional, removes hero font CLS */
@font-face {
  font-family: "Montserrat";
  src: url("../m-files.cdn1.cc/web/user/fonts/montserrat/montserrat_normal.woff2") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: optional;
}
@font-face {
  font-family: "Montserrat";
  src: url("../m-files.cdn1.cc/web/user/fonts/montserrat/montserrat_bold.woff2") format("woff2");
  font-weight: 700;
  font-style: normal;
  font-display: optional;
}
.ctx-page .rk-section {
  padding: 48px 0;
}
.ctx-page .rk-h2 {
  margin: 0 0 28px;
  font-size: clamp(24px, 3vw, 32px);
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  color: #7f3ff2;
}
.ctx-page .rk-breadcrumbs {
  width: min(100% - var(--rk-gutter) * 2, var(--rk-container));
  margin: 12px auto 0;
  padding: 0;
  font-size: 13px;
  line-height: 1.45;
  color: #6b6b6b;
}
.ctx-page .rk-breadcrumbs ol {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  align-items: center;
}
.ctx-page .rk-breadcrumbs li {
  display: inline-flex;
  align-items: center;
}
.ctx-page .rk-breadcrumbs li:not(:last-child)::after {
  content: "→";
  margin: 0 8px;
  color: #b0b0b0;
}
.ctx-page .rk-breadcrumbs a {
  color: #5a5a5a;
  text-decoration: none;
}
.ctx-page .rk-breadcrumbs a:hover,
.ctx-page .rk-breadcrumbs a:focus-visible {
  color: #9867f3;
  outline: none;
}
.ctx-page .rk-breadcrumbs [aria-current="page"] {
  color: #3a3a3a;
  font-weight: 600;
}

/* Hero title font: avoid CLS from late webfont swap on long city H1 */
@font-face {
  font-family: "Montserrat";
  src: url("../m-files.cdn1.cc/web/user/fonts/montserrat/montserrat_bold.woff2") format("woff2");
  font-weight: 700;
  font-style: normal;
  font-display: optional;
}

/* Hero */
.ctx-hero {
  padding: 20px 0 40px;
  background: linear-gradient(180deg, #f7f5ff 0%, #fff 55%);
}
.ctx-hero__grid {
  display: grid;
  gap: 28px;
  align-items: center;
}
.ctx-hero__title {
  margin: 0 0 10px;
  font-size: clamp(28px, 4.2vw, 40px);
  font-weight: 700;
  line-height: 1.2;
  min-height: 2.4em;
  background-image: linear-gradient(260deg, rgb(223, 98, 226) 10%, rgb(106, 92, 234) 90%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
}
.ctx-hero__sub {
  margin: 0 0 14px;
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 700;
  line-height: 1.25;
  min-height: 2.5em;
  color: #111;
}
.ctx-hero__sub em {
  font-style: normal;
  color: #7f3ff2;
}
.ctx-hero__lead {
  margin: 0 0 20px;
  max-width: 54ch;
  font-size: 16px;
  line-height: 1.55;
  color: #3a3a3a;
}
.ctx-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 18px;
}
.ctx-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 48px;
  padding: 12px 18px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 15px;
  line-height: 1.2;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
}
.ctx-btn:focus-visible {
  outline: 2px solid #7f3ff2;
  outline-offset: 2px;
}
.ctx-btn--primary {
  color: #fff;
  background: linear-gradient(270deg, rgb(223, 98, 226) 9%, rgb(106, 92, 234) 90%);
  box-shadow: 0 8px 20px rgba(127, 63, 242, 0.25);
}
.ctx-btn--primary:hover {
  transform: translateY(-1px);
}
.ctx-btn__arrow {
  display: inline-flex;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #7f3ff2;
  font-size: 14px;
  line-height: 1;
}
.ctx-btn--ghost {
  color: #004f9a;
  background: #fff;
  border: 0.8px solid rgba(30, 30, 30, 0.22);
}
.ctx-btn--ghost:hover {
  border-color: #7f3ff2;
  color: #7f3ff2;
}
.ctx-trust {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}
.ctx-trust__item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #fff;
  border: 1px solid #ebe7f7;
  box-shadow: 0 4px 14px rgba(80, 60, 140, 0.06);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.3;
  color: #111;
}
.ctx-trust__item img,
.ctx-trust__ico {
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
}
.ctx-hero__visual {
  margin: 0;
  aspect-ratio: 600 / 512;
}
.ctx-hero__visual img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 16px;
  box-shadow: 0 16px 40px rgba(80, 60, 140, 0.12);
}
@media (max-width: 767px) {
  .ctx-hero__title {
    min-height: 3.6em;
    font-size: clamp(26px, 7vw, 34px);
  }
  .ctx-hero__sub {
    min-height: 2.5em;
    font-size: clamp(18px, 4.6vw, 24px);
  }
  .ctx-hero__lead {
    min-height: 4.8em;
  }
  .ctx-trust {
    grid-template-columns: 1fr;
  }
  .ctx-hero__actions .ctx-btn {
    white-space: nowrap;
  }
}

/* Service cards */
.ctx-services {
  padding-top: 8px;
  padding-bottom: 40px;
  background: #fff;
}
.ctx-services__grid {
  display: grid;
  gap: 16px;
  grid-template-columns: 1fr;
}
.ctx-scard {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 22px 20px;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #ebe7f7;
  box-shadow: 0 8px 24px rgba(80, 60, 140, 0.07);
  text-decoration: none;
  color: inherit;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.ctx-scard:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(80, 60, 140, 0.12);
}
.ctx-scard:focus-visible {
  outline: 2px solid #7f3ff2;
  outline-offset: 2px;
}
.ctx-scard__head {
  display: flex;
  align-items: center;
  gap: 12px;
}
.ctx-scard__icon {
  width: 48px;
  height: 48px;
  flex: 0 0 auto;
  border-radius: 50%;
  object-fit: cover;
}
.ctx-scard__icon--svg {
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #6a5cea, #4aa3ff);
  color: #fff;
}
.ctx-scard__icon--svg svg {
  width: 26px;
  height: 26px;
}
.ctx-scard h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.3;
  color: #111;
}
.ctx-scard h2 .ctx-accent-google { color: #1a73e8; }
.ctx-scard h2 .ctx-accent-yandex { color: #d93025; }
.ctx-scard h2 .ctx-accent-geo,
.ctx-scard h2 .ctx-accent-aeo { color: #2f6fed; }
.ctx-scard p {
  margin: 0;
  flex: 1;
  font-size: 14px;
  line-height: 1.5;
  color: #444;
}
.ctx-scard__more {
  margin-top: 4px;
  font-size: 14px;
  font-weight: 600;
  color: #7f3ff2;
}

/* Includes */
.ctx-includes {
  background: #f8f7fc;
}
.ctx-includes__grid {
  display: grid;
  gap: 18px;
  grid-template-columns: 1fr;
}
.ctx-inc {
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 12px;
  align-items: start;
}
.ctx-inc img {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  object-fit: cover;
  background: #fff;
}
.ctx-inc h3 {
  margin: 0 0 4px;
  font-size: 16px;
  font-weight: 700;
  color: #111;
}
.ctx-inc p {
  margin: 0;
  font-size: 14px;
  line-height: 1.45;
  color: #444;
}

/* Work blocks */
.ctx-blocks__grid {
  display: grid;
  gap: 22px;
  grid-template-columns: 1fr;
}
.ctx-block {
  text-align: center;
  padding: 8px 10px;
}
.ctx-block img {
  width: min(140px, 40vw);
  height: auto;
  margin: 0 auto 12px;
}
.ctx-block h3 {
  margin: 0 0 8px;
  font-size: 18px;
  font-weight: 700;
  color: #111;
}
.ctx-block p {
  margin: 0 auto;
  max-width: 42ch;
  font-size: 14px;
  line-height: 1.5;
  color: #444;
}

/* Process */
.ctx-process {
  background: #f8f7fc;
}
.ctx-process__grid {
  display: grid;
  gap: 20px;
  grid-template-columns: 1fr;
  counter-reset: ctx-step;
}
.ctx-step {
  position: relative;
  padding: 8px 8px 8px 0;
}
.ctx-step__num {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  margin-bottom: 10px;
  border-radius: 50%;
  background: linear-gradient(135deg, #4aa3ff, #7f3ff2);
  color: #fff;
  font-weight: 700;
  font-size: 16px;
}
.ctx-step h3 {
  margin: 0 0 8px;
  font-size: 17px;
  font-weight: 700;
  color: #111;
}
.ctx-step p {
  margin: 0;
  font-size: 14px;
  line-height: 1.5;
  color: #444;
}

/* Synergy */
.ctx-synergy__grid {
  display: grid;
  gap: 18px;
  grid-template-columns: 1fr;
}
.ctx-syn {
  padding: 22px 20px;
  border-radius: 14px;
  background: #fff;
  border: 1px solid #ebe7f7;
  box-shadow: 0 8px 24px rgba(80, 60, 140, 0.06);
}
.ctx-syn__icon {
  width: 64px;
  height: 64px;
  margin: 0 0 14px;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}
.ctx-syn h3 {
  margin: 0 0 8px;
  font-size: 18px;
  font-weight: 700;
  color: #111;
}
.ctx-syn > p {
  margin: 0 0 12px;
  font-size: 14px;
  line-height: 1.45;
  color: #444;
}
.ctx-syn ul {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 8px;
}
.ctx-syn li {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  font-size: 14px;
  line-height: 1.4;
  color: #222;
}
.ctx-syn li::before {
  content: "✔";
  color: #2f6fed;
  font-weight: 700;
  flex: 0 0 auto;
}

/* KPI */
.ctx-kpi {
  background: #f8f7fc;
}
.ctx-kpi__grid {
  display: grid;
  gap: 14px;
  grid-template-columns: 1fr 1fr;
}
.ctx-kpi__card {
  min-height: 160px;
  padding: 18px 16px 14px;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #ebe7f7;
  box-shadow: 0 6px 18px rgba(80, 60, 140, 0.06);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
}
.ctx-kpi__card img {
  width: 100%;
  height: auto;
  margin: 0;
  display: block;
}
.ctx-kpi__card h3 {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  text-align: left;
  color: #111;
}

/* Approach */
.ctx-approach__grid {
  display: grid;
  gap: 14px;
  grid-template-columns: 1fr;
}
.ctx-approach__card {
  padding: 20px 18px;
  border-radius: 12px;
  background: #fff;
  border: 1px solid #ebe7f7;
  box-shadow: 0 6px 18px rgba(80, 60, 140, 0.06);
}
.ctx-approach__card h3 {
  margin: 0 0 10px;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.3;
}
.ctx-approach__card--prolevel h3 .tag { color: #24a0ff; }
.ctx-approach__card--darktruth h3 .tag { color: #7f3ff2; }
.ctx-approach__card--x10mind h3 .tag { color: #3db8ff; }
.ctx-approach__card--killcritic h3 .tag { color: #2f5bff; }
.ctx-approach__card h3 .rest { color: #3a3a3a; }
.ctx-approach__card p {
  margin: 0;
  font-size: 14px;
  line-height: 1.5;
  color: #444;
}

/* FAQ tweaks on page */
.ctx-page #faq .rk-h2 {
  text-align: center;
}
.ctx-page .rk-faq {
  max-width: 920px;
  margin: 0 auto;
}

/* Bottom CTA strip reused from home patterns */
.ctx-cta-band {
  padding: 36px 0 48px;
  background: linear-gradient(270deg, rgb(223, 98, 226) 9%, rgb(106, 92, 234) 90%);
  color: #fff;
  text-align: center;
}
.ctx-cta-band h2 {
  margin: 0 0 10px;
  font-size: clamp(22px, 3vw, 28px);
  font-weight: 700;
  color: #fff;
}
.ctx-cta-band p {
  margin: 0 auto 18px;
  max-width: 48ch;
  font-size: 15px;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.95);
}
.ctx-cta-band .ctx-btn--light {
  color: #7f3ff2;
  background: #fff;
}

@media (min-width: 768px) {
  .ctx-services__grid {
    grid-template-columns: 1fr 1fr;
  }
  .ctx-includes__grid {
    grid-template-columns: 1fr 1fr;
  }
  .ctx-blocks__grid {
    grid-template-columns: 1fr 1fr;
  }
  .ctx-process__grid {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .ctx-synergy__grid {
    grid-template-columns: 1fr 1fr;
  }
  .ctx-approach__grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (min-width: 1100px) {
  .ctx-hero__grid {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 36px;
  }
  .ctx-services__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ctx-includes__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ctx-blocks__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .ctx-process__grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .ctx-synergy__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .ctx-kpi__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ctx-approach__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ctx-page .rk-section {
    padding: 56px 0;
  }
}

@media (max-width: 767px) {
  .ctx-trust {
    grid-template-columns: 1fr;
  }
  .ctx-hero__actions {
    flex-direction: column;
  }
  .ctx-hero__actions .ctx-btn {
    width: 100%;
  }
  .ctx-kpi__grid {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ctx-btn,
  .ctx-scard {
    transition: none;
  }
  .ctx-btn--primary:hover,
  .ctx-scard:hover {
    transform: none;
  }
}

/* Audience */
.ctx-audience__grid{display:grid;gap:14px;grid-template-columns:1fr}
.ctx-aud{padding:20px 18px;border-radius:12px;background:#fff;border:1px solid #ebe7f7;box-shadow:0 6px 18px rgba(80,60,140,.06)}
.ctx-aud h3{margin:0 0 8px;font-size:17px;font-weight:700;color:#111}
.ctx-aud p{margin:0;font-size:14px;line-height:1.5;color:#444}

/* Pricing */
.ctx-pricing{background:#f8f7fc}
.ctx-pricing__grid{display:grid;gap:16px;grid-template-columns:1fr}
.ctx-price{display:flex;flex-direction:column;gap:10px;padding:22px 20px;border-radius:12px;background:#fff;border:1px solid #ebe7f7;box-shadow:0 8px 24px rgba(80,60,140,.07)}
.ctx-price--featured{border:2px solid #b13dff}
.ctx-price__badge{align-self:flex-start;padding:4px 10px;border-radius:999px;background:linear-gradient(270deg,rgb(223,98,226) 9%,rgb(106,92,234) 90%);color:#fff;font-size:12px;font-weight:700}
.ctx-price h3{margin:0;font-size:22px;font-weight:700;color:#7f3aff}
.ctx-price__lead{margin:0;font-size:14px;color:#555}
.ctx-price__cost{margin:0;font-size:20px;font-weight:700;color:#111}
.ctx-price ul{margin:0;padding:0;list-style:none;display:grid;gap:8px}
.ctx-price li{display:flex;gap:8px;font-size:14px;line-height:1.4;color:#222}
.ctx-price li::before{content:"✔";color:#7f3ff2;font-weight:700}
.ctx-pricing__note{margin:18px 0 0;text-align:center;font-size:14px;color:#555}

/* Cases */
.ctx-cases__grid{display:grid;gap:14px;grid-template-columns:1fr}
.ctx-case{padding:20px 18px;border-radius:12px;background:#fff;border:1px solid #ebe7f7;box-shadow:0 6px 18px rgba(80,60,140,.06)}
.ctx-case__tag{display:inline-block;margin-bottom:8px;padding:4px 10px;border-radius:8px;background:#f3edff;color:#7f3ff2;font-size:13px;font-weight:700}
.ctx-case h3{margin:0 0 10px;font-size:17px;font-weight:700;color:#111}
.ctx-case ul{margin:0 0 10px;padding:0;list-style:none;display:grid;gap:6px}
.ctx-case li{font-size:14px;line-height:1.4;color:#222}
.ctx-case li::before{content:"✔ ";color:#7f3ff2;font-weight:700}
.ctx-case p{margin:0;font-size:14px;line-height:1.45;color:#444}

/* Related */
.ctx-related__grid{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.ctx-related__grid a{display:inline-flex;align-items:center;min-height:44px;padding:10px 14px;border-radius:10px;border:1px solid #ebe7f7;background:#fff;color:#3a3a3a;text-decoration:none;font-size:14px;font-weight:600}
.ctx-related__grid a:hover,.ctx-related__grid a:focus-visible{color:#7f3ff2;border-color:#7f3ff2;outline:none}

@media (min-width:768px){
.ctx-audience__grid,.ctx-pricing__grid,.ctx-cases__grid{grid-template-columns:1fr 1fr}
.ctx-services__grid{grid-template-columns:1fr 1fr}
}
@media (min-width:1100px){
.ctx-audience__grid{grid-template-columns:repeat(4,minmax(0,1fr))}
.ctx-pricing__grid,.ctx-cases__grid{grid-template-columns:repeat(3,minmax(0,1fr))}
.ctx-services__grid{grid-template-columns:1fr 1fr}
}

/* Local city block */
.ctx-local__lead{margin:0 0 28px;max-width:720px;font-size:16px;line-height:1.55;color:#444}
.ctx-local__grid{display:grid;gap:14px;grid-template-columns:1fr}
@media (min-width:768px){
.ctx-local__grid{grid-template-columns:1fr 1fr}
}
@media (min-width:1100px){
.ctx-local__grid{grid-template-columns:repeat(4,minmax(0,1fr))}
}
