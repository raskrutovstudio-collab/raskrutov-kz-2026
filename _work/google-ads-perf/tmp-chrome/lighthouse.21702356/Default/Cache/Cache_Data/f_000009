  border: 1px solid rgba(127, 63, 242, 0.12);
  font-size: 12px;
  font-weight: 700;
  color: #3b2a6e;
}

.gads-flow-track__arrow {
  width: 14px;
  height: 2px;
  border-radius: 2px;
  background: #7f3ff2;
